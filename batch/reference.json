{
  "version": 1,
  "description": "Show/movie reference map for getsubtitle batch processing. Folder name → metadata. Edit freely; lookup.py can backfill empty *_id fields by searching AniList / IMDb / TMDB.",
  "schema": {
    "key": "Folder path relative to the script's CWD (or just the leaf folder name). The script tries the exact key first, then the parent folder.",
    "entry": {
      "title": "Romanized / English title used in --title fallback.",
      "title_native": "Native-script title (optional, informational).",
      "title_localized": "Korean/local title as it appears on disk (optional, informational).",
      "year": "Release year (optional).",
      "type": "show | movie",
      "profile": "ja | ko | en — drives fetch/merge rules. ja=fetch ko first, MT ko if missing. ko=fetch ja first, MT ja if missing. en=fetch es+ko first, MT from en if missing. Non-ja/ko origins (zh, fr, es, ...) default to en profile.",
      "anilist_id": "AniList ID for anime; used by Jimaku.",
      "imdb_id": "IMDb tt-id for live-action; used by Wyzie.",
      "tmdb_id": "TMDB integer ID; secondary lookup for Wyzie.",
      "season": "Season number (1-indexed) for shows; null for movies.",
      "episode_count": "Optional total episode count for `-e all` short-circuiting.",
      "episode_range": "Optional explicit range like \"13-24\" for partial seasons (Mashle S2 cours 2 etc).",
      "needs_lookup": "true when *_id fields are empty pending research. lookup.py uses this to find work.",
      "notes": "Free-form maintainer notes."
    },
    "profiles": {
      "ja": "Japanese-origin (anime + Japanese live-action). Master=ja. Fetch Korean subs first; MT ja→ko fallback. Combine: ja+ko with master=ja, furigana on.",
      "ko": "Korean-origin (K-drama, K-variety). Master=ko. Fetch Japanese subs first (Wyzie); MT ko→ja fallback. Combine: ko+ja (+en+es if available) with master=ko.",
      "en": "English / Western / Other-origin. Master=en. Fetch Spanish + Korean first; MT from en fallback. Combine: en+es dual AND ja+ko+en+es quad."
    }
  },
